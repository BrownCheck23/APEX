# Core
PAPER_TRADING=true                    # Set to false ONLY when ready for real money
ANTHROPIC_API_KEY=                    # Anthropic API key - used ONLY by the self-improvement evaluator
TYPESAFE_AI_API_KEY=                  # TypeSafe AI key - for Jev (@ai-sdk/typesafe-ai reads this variable)
VERCEL_AI_GATEWAY_TOKEN=              # Optional fallback: used as the Jev API key if TYPESAFE_AI_API_KEY is empty

# Robinhood. Run `npm run robinhood:auth` once to log in; the token is stored in data/robinhood-token.json
ROBINHOOD_MCP_AUTH_TOKEN=             # Optional: a manually obtained token (overrides the stored one, cannot auto-refresh)
ROBINHOOD_ACCOUNT_NUMBER=             # Alphanumeric account number (from get_accounts)
ROBINHOOD_RHS_ACCOUNT_NUMBER=         # Numeric account number (for crypto, from get_accounts)

# Strategy
CONFIDENCE_THRESHOLD=0.65             # Minimum Jev confidence to place a trade
HARD_STOP_PCT=0.10                    # Kill switch: shut down at -10% total capital loss
SOFT_STOP_PCT=0.05                    # Pause at -5%, run evaluation, resume
EVALUATION_TRADE_COUNT=50             # Run self-improvement every N trades
MAX_POSITION_SIZE_PCT=0.05            # Max 5% of portfolio in any single position
EQUITY_CYCLE_MINUTES=15               # How often equity loop runs during market hours
CRYPTO_CYCLE_MINUTES=30               # How often crypto loop runs (24/7)

# Cost controls
APEX_CLAUDE_MODEL=claude-sonnet-4-6                # Model for the self-improvement evaluator (the only Claude call)
APEX_ENABLE_OPTIONS=true              # false = skip the options cycle entirely
APEX_ENABLE_CRYPTO=true               # false = skip the crypto cycle entirely
WATCHLIST_SIZE=2                      # Symbols traded per cycle (max 4, the L2 book limit)

# Dashboard
DASHBOARD_PORT=3001

# Scan
MOMENTUM_SCANNER_ID=7c777075          # Existing Robinhood scan ID to pull watchlist from

# Offline simulation (no Anthropic / Jev / Robinhood calls, no API spend). Paper mode only.
APEX_OFFLINE_SIM=false
