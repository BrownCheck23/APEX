{
  "name": "apex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ai-sdk/typesafe-ai": "latest",
    "@anthropic-ai/sdk": "latest",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ai": "latest",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "node-cron": "^3.0.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  },
  "scripts": {
    "start": "tsx src/bot.ts",
    "dev": "tsx watch src/bot.ts",
    "dashboard": "tsx src/dashboard/server.ts",
    "typecheck": "tsc --noEmit",
    "robinhood:auth": "tsx scripts/robinhood-auth.ts",
    "robinhood:tools": "tsx scripts/robinhood-tools.ts",
    "verify": "tsx --env-file=scripts/offline.env scripts/verify.ts",
    "simulate": "tsx --env-file=scripts/simulate.env scripts/simulate.ts 40"
  }
}
